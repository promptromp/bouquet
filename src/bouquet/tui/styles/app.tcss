Screen {
    layout: vertical;
}

.project-header {
    dock: top;
    height: 3;
    content-align: center middle;
    background: $primary-background;
    color: $text;
    padding: 1;
}

#body {
    height: 1fr;
}

#left-panel {
    width: 1fr;
    padding: 1 2;
    border-right: tall $accent;
}

#right-panel {
    width: 1fr;
    padding: 1 2;
}

#section-title {
    margin-bottom: 1;
    text-style: bold;
}

.worktree-table {
    height: 1fr;
}

#empty-state {
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}

#detail-container,
#tasks-container {
    border: round $accent;
    border-title-color: $text;
    border-title-style: bold;
}

#detail-container {
    height: 1fr;
    min-height: 7;
}

#tasks-container {
    height: 1fr;
}

WorktreeDetailPanel {
    height: auto;
    padding: 0 1;
}

#task-queue-empty {
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}

.task-queue-table {
    height: 1fr;
}

#status-line {
    dock: bottom;
    height: 1;
    background: $primary-background;
    padding: 0 1;
}
