Screen {
    layout: vertical;
}

.project-header {
    dock: top;
    height: auto;
    max-height: 8;
    content-align: right middle;
    background: $accent;
    color: $text;
    text-style: bold;
    padding: 0 2;
}

#body {
    height: 1fr;
    padding: 1 2;
}

#section-title {
    margin-bottom: 1;
    text-style: bold;
}

.worktree-table {
    height: 1fr;
}

#status-line {
    dock: bottom;
    height: 1;
    background: $primary-background;
    padding: 0 1;
}
